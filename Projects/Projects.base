filters:
  and:
    - file.inFolder("Projects")
    - 'type == "project"'

views:
  - type: table
    name: "All projects"
    order:
      - file.name
      - note.status
      - note.created
      - note.tags
    groupBy:
      property: note.status

  - type: table
    name: "Active only"
    order:
      - file.name
      - note.created
    filters:
      and:
        - 'status == "active"'
